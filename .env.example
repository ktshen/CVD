# Empty means every Binance Spot symbol. For lower disk usage, use USDT only.
CVD_QUOTE_ASSETS=USDT
# Or collect an explicit list; this takes precedence together with quote filtering.
CVD_SYMBOLS=BTCUSDT,ETHUSDT
CVD_DB_PATH=data/market.db
CVD_RETENTION_DAYS=5
CVD_CLEANUP_INTERVAL_SECONDS=3600
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision/ws